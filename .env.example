# Copy this file to .env and fill in your values
# NEVER share or commit your .env file

# Your Solana wallet private key (base58 encoded)
WALLET_PRIVATE_KEY=your_private_key_here

# Solana RPC endpoint (use a reliable one)
# Free options: https://api.mainnet-beta.solana.com
# Paid (faster): Helius, QuickNode, Alchemy
RPC_URL=https://api.mainnet-beta.solana.com

# Minimum SOL to keep in wallet (never stake below this)
# Recommended: at least 0.05 SOL for transaction fees
MIN_SOL_BALANCE=0.05

# How often to check and compound rewards (in hours)
COMPOUND_INTERVAL_HOURS=24
